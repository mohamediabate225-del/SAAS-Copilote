# Obligatoire
OPENAI_API_KEY=sk-...

# Optionnels (valeurs par défaut ci-dessous)
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ANSWER_MODEL=gpt-4o-mini
PORT=3000

# Si tu déploies en ligne, protège ton application (sinon n'importe qui consomme ton crédit)
# APP_PASSWORD=choisis-un-mot-de-passe

# Récupération par email : renseigner les identifiants de votre fournisseur SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=votre_utilisateur
# SMTP_PASSWORD=votre_mot_de_passe_application
# SMTP_FROM=Copilote Entretien <contact@example.com>
# APP_BASE_URL=http://localhost:3101
