# Obligatoire
OPENAI_API_KEY=sk-...

# Optionnels (valeurs par défaut ci-dessous)
TRANSCRIBE_MODEL=gpt-4o-transcribe
ANSWER_MODEL=gpt-4.1-mini
PORT=3100
# HOST=127.0.0.1 (défaut local ; 0.0.0.0 en production)
APP_BASE_URL=http://localhost:3100
# EXTENSION_ID=identifiant Chrome exact de 32 lettres a-p
# GROUNDED_ANSWER_MODEL=gpt-4.1
# BACKUP_DIR=/backups

# Prévisualisation HTTPS (facultatif) : jeton unique et aléatoire, au moins 32 caractères.
# PREVIEW_TOKEN=
# Production : origine HTTPS exacte et volume persistant.
# APP_BASE_URL=https://copilote.example
# COPILOTE_DB_PATH=/data/copilote.sqlite
# TRUST_PROXY=loopback

# Récupération par email : renseigner les identifiants de votre fournisseur SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=votre_utilisateur
# SMTP_PASSWORD=votre_mot_de_passe_application
# SMTP_FROM=Copilote Entretien <contact@example.com>

# Facturation facultative. Créer les tarifs récurrents et configurer le portail chez Stripe.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS=
# STRIPE_PRICE_PRO=

# Connexions facultatives. Enregistrer APP_BASE_URL/auth/return/google et /auth/return/apple chez les fournisseurs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET= (JWT signé par le compte développeur Apple, à renouveler avant expiration)
# AI_MODELS=gpt-4o-mini,gpt-4.1-mini
# WEB_MODEL=gpt-4.1-mini
# IMAGE_MODEL=gpt-image-1.5

# Accès gratuit pendant les tests. Activer seulement après validation du lancement commercial.
BILLING_ENABLED=false
